{
  "hosting": {
    "public": "dist",
    "predeploy": ["npm run build"],
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md",
      "domain/**",
      "copy/**",
      "seo/**"
    ],
    "headers": [
      {
        "source": "/tokens/**",
        "headers": [
          { "key": "Content-Type", "value": "text/css; charset=utf-8" }
        ]
      }
    ],
    "rewrites": []
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ]
}
