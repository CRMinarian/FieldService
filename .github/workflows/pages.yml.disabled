# DISABLED — do not rename this file back to pages.yml.
#
# fieldservicenerd.com DNS points at Firebase Hosting (apex A records to
# Firebase, www CNAME to field-service-nerd.web.app). GitHub Pages is not
# the production host. A workflow that publishes to Pages on every main
# merge is misleading: it looks like the site shipped when the domain
# still serves whatever was last `firebase deploy`ed.
#
# Production publish is:
#   firebase deploy --only hosting --project field-service-nerd
# after `npm run build` (also a hosting.predeploy hook).
#
# Site integrity (tokens + referenced assets) lives in site-integrity.yml.
#
# Original workflow kept below for history only.

name: Deploy GitHub Pages

on:
  push:
    branches: ["main"]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Build hosting tree
        run: npm run build

      - name: Confirm token CSS is in the artifact
        run: |
          test -f dist/tokens/colors.css
          test -f dist/tokens/effects.css
          test -f dist/tokens/fonts.css
          test -f dist/tokens/spacing.css
          test -f dist/tokens/typography.css
          ls -l dist/tokens

      - name: Configure Pages
        uses: actions/configure-pages@v5

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
